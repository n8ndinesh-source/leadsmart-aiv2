datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // ADMIN, CLIENT
  createdAt DateTime @default(now())
  client    Client?
}

model Client {
  id                 String        @id @default(uuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  phone              String?
  website            String?
  industry           String?
  businessType       String?
  description        String?
  country            String?
  state              String?
  city               String?
  accountStatus      String        @default("Active") // Active, Suspended, Pending
  subscriptionStatus String        @default("Trial")  // Trial, Active, Expired, Suspended, Cancelled
  
  // WhatsApp Integration credentials
  whatsappToken              String?
  whatsappPhoneId            String?
  whatsappWebhookVerifyToken String?
  whatsappWebhookUrl         String?
  whatsappStatus             String?       @default("Inactive") // Active, Inactive, Failed
  ownerWhatsApp              String?
  approvalNotificationNumber String?
  catalogPdfUrl              String?       @default("")

  // Custom AI Assistant configuration and custom LLM API Key
  aiProvider                 String?       @default("gemini")
  aiModel                    String?       @default("gemini-3.5-flash")
  aiApiKey                   String?
  aiAssistantName            String?       @default("LeadSmart AI")

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subscription       Subscription?
  aiConfiguration    AIConfiguration?
  testLogs           AITestLogs[]
  leads              Lead[]
  aiPermissions      AIPermission[]
  quotationTemplates QuotationTemplate[]
  quotations         Quotation[]
  productFields      ProductField[]
  productRecords     ProductRecord[]
}

model AIConfiguration {
  id                  String   @id @default(uuid())
  clientId            String   @unique
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  businessProfile     String
  productIntelligence String
  salesBehavior       String
  customerRules       String
  followUpRules       String
  responseControl     String
  businessGoals       String

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AITestLogs {
  id                String   @id @default(uuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inputMessage      String
  aiResponse        String
  leadScore         Int
  intent            String
  recommendedAction String
  createdAt         DateTime @default(now())
}

model Subscription {
  id         String   @id @default(uuid())
  clientId   String   @unique
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planName   String   // Starter, Growth, Pro, Enterprise
  status     String   // Trial, Active, Expired, Suspended, Cancelled
  startDate  DateTime @default(now())
  expiryDate DateTime
  price      Float
  createdAt  DateTime @default(now())
}

model Plan {
  id                 String   @id @default(uuid())
  name               String   @unique // Starter, Growth, Pro, Enterprise
  price              Float
  maxUsers           Int
  maxLeads           Int
  maxAiRequests      Int
  maxWhatsappNumbers Int
  features           String   // comma-separated list of features
  createdAt          DateTime @default(now())
}

model Lead {
  id               String         @id @default(uuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  phoneNumber      String
  email            String?
  source           String         // WhatsApp / Manual / Import
  status           String         // New, Contacted, Interested, Qualified, Quotation Sent, Negotiation, Won, Lost
  priority         String         // Hot, Warm, Cold
  intentScore      Int?
  leadScore        Int?
  aiRecommendation String?
  
  customOrderRequired Boolean @default(false)
  customOrderSpecs   String?   // JSON string storing spec detail: { product, size, quantity }
  
  // WhatsApp tracking details
  lastMessageAt      DateTime?
  whatsappNumber     String?
  conversationStatus String?        @default("Active")
  urgencyLevel       String?        // Place holder for Phase 7
  messages           Message[]

  // Phase 6 Follow-Up Tracking
  followUpCount          Int            @default(0)
  lastFollowUpAt         DateTime?
  nextFollowUpAt         DateTime?
  followUpStatus         String         @default("None") // None, Pending, Overdue, Completed, Failed
  lastResponseFromClient Boolean        @default(true) // True if last message was from the lead
  followUps              FollowUp[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notes            LeadNote[]
  tags             LeadTag[]
  activities       LeadActivity[]
  
  // Phase 9 Intent Detection Engine
  latestIntent     String?
  intentHistory    String?        @default("[]")
  leadIntents      LeadIntent[]

  // Lead Stage Engine
  currentStage     String         @default("NEW")
  previousStage    String?
  stageHistory     String?        @default("[]")
  leadStageHistories LeadStageHistory[]
  quotations         Quotation[]
}

model FollowUp {
  id           String    @id @default(uuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    // Pending, Sent, Failed, Missed
  message      String
  followUpType String    // Soft, Medium, Hard, Final
  createdAt    DateTime  @default(now())
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())
}

model LeadTag {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag       String
  createdAt DateTime @default(now())
}

model LeadActivity {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType String   // e.g. "CREATED", "STATUS_CHANGE", "NOTE_ADDED", "TAG_ADDED", "FOLLOWUP"
  description  String
  createdAt    DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction String   // IN or OUT
  content   String
  timestamp DateTime @default(now())
}

model AIDecisionLog {
  id                    String   @id @default(uuid())
  clientId              String
  leadId                String
  leadScore             Int
  intent                String
  conversionProbability String
  nextBestAction        String
  suggestedReply        String
  revenueImpact         String
  createdAt             DateTime @default(now())
}

model AIActionsLog {
  id                String   @id @default(uuid())
  clientId          String
  actionType        String
  targetEntity      String   // Lead / FollowUp / Note
  targetId          String
  actionDescription String
  status            String   // Pending / Executed / Failed
  createdAt         DateTime @default(now())
}

model AIChatHistory {
  id        String   @id @default(uuid())
  clientId  String
  message   String
  response  String
  createdAt DateTime @default(now())
}

model AIPermission {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  permissionName String
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clientId, permissionName])
}

model LeadIntent {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message    String
  intent     String
  confidence Float
  createdAt  DateTime @default(now())

  @@map("lead_intents")
}

model LeadStageHistory {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStage   String
  newStage   String
  reason     String
  confidence Float
  createdAt  DateTime @default(now())

  @@map("lead_stage_history")
}

model QuotationTemplate {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String   // e.g. "Standard Quotation", "Distributor Quotation", etc.
  companyName     String
  logo            String?  // base64 image or url
  headerBanner    String?  // base64 image or url (Recommended: 2480 x 400 px)
  footerBanner    String?  // base64 image or url (Recommended: 2480 x 250 px)
  watermark       String?  // base64 image or url (Recommended: 1500 x 1500 px)
  watermarkOpacity Int     @default(15) // stored as raw percentage (e.g., 15 for 15%)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  quotations      Quotation[]
}

model Quotation {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId       String?
  template         QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  quotationNumber  String   // e.g. "QT-2026-001"
  status           String   @default("DRAFT") // DRAFT, READY, SENT, VIEWED, ACCEPTED, REJECTED
  products         String   // JSON string: array of products { name, description, quantity, price, discount, gst, tax, deliveryCharges }
  subtotal         Float
  discountPercent  Float    @default(0)
  discountAmount   Float    @default(0)
  gstPercent       Float    @default(0)
  gstAmount        Float    @default(0)
  taxPercent       Float    @default(0)
  taxAmount        Float    @default(0)
  deliveryCharges  Float    @default(0)
  grandTotal       Float
  deliveryTerms    String?
  paymentTerms     String?
  validity         String?
  additionalNotes  String?
  scheduledAt      DateTime? // Current Time + 5 Minutes (if READY)
  deliveredAt      DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  pdfBase64        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductField {
  id           String               @id @default(uuid())
  clientId     String
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fieldName    String               // e.g. "Item Name", "GSM", "BHK"
  fieldType    String               // Text, Textarea, Number, Currency, Dropdown, Multi Select, Date, Checkbox, Image Upload, File Upload
  required     Boolean              @default(false)
  active       Boolean              @default(true)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  values       ProductRecordValue[]

  @@map("product_fields")
}

model ProductRecord {
  id           String               @id @default(uuid())
  clientId     String
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String               // Easy-to-read title or display name (e.g., Bagasse Plate 10 Inch)
  code         String               @default("") // Custom product/SKU code (e.g. BP-10N, etc.)
  category     String?              // Optional category
  status       String               @default("ACTIVE") // ACTIVE, OUT_OF_STOCK, INACTIVE etc.
  businessType String               // "Manufacturing" | "Real Estate"
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  values       ProductRecordValue[]

  @@map("product_records")
}

model ProductRecordValue {
  id              String        @id @default(uuid())
  productRecordId String
  productRecord   ProductRecord @relation(fields: [productRecordId], references: [id], onDelete: Cascade)
  productFieldId  String
  productField    ProductField  @relation(fields: [productFieldId], references: [id], onDelete: Cascade)
  value           String        // Stored as string, parsed/typed according to fieldType
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([productRecordId, productFieldId])
  @@map("product_record_values")
}

model OwnerAlert {
  id        String   @id @default(uuid())
  clientId  String
  leadId    String
  title     String
  message   String
  type      String   // "QUOTATION_APPROVAL", "CUSTOM_ORDER_ALERT"
  status    String   // "PENDING", "APPROVED", "REJECTED", "EDITED"
  amount    Float?
  specs     String?  // JSON string
  quoteId   String?  // If QUOTATION_APPROVAL
  createdAt DateTime @default(now())
}



